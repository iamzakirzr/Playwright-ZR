# Copy to .env and override as needed. All keys are optional.

# UI / API targets
UI_BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://restful-booker.herokuapp.com
# Pin a pre-installed Chromium when `playwright install` isn't possible
# BROWSER_EXECUTABLE_PATH=/opt/pw-browsers/chromium

# SQL (":memory:" or a file path)
DB_PATH=:memory:

# Live chatbot (open-source model via Ollama)
OLLAMA_HOST=http://localhost:11434
CHATBOT_MODEL=qwen2.5:1.5b

# Evaluation
JUDGE_MODEL=llama3.2:3b
RAGAS_JUDGE_MODEL=qwen2.5:7b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.70
FAITHFULNESS_THRESHOLD=0.70
